<?xml version="1.0" encoding="utf-8"?>
<!-- Shared settings for sharepoint.vcxproj and the lang_*.vcxproj projects.
     Workspace layout: the plugin SDK is taken from the samandarin fork,
     salamander\samandarin\src (so $(SalamanderSdkDir)plugins\shared is the SDK). Override with
     /p:SalamanderSdkDir=<path to a dir containing plugins\shared> if it lives elsewhere. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <SharepointRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</SharepointRootDir>
    <SharepointSrcDir>$(SharepointRootDir)src\</SharepointSrcDir>
    <SalamanderSdkDir Condition="'$(SalamanderSdkDir)'==''">$([System.IO.Path]::GetFullPath('$(SharepointRootDir)..\..\samandarin\src'))</SalamanderSdkDir>
    <SalamanderSdkDir Condition="!HasTrailingSlash('$(SalamanderSdkDir)')">$(SalamanderSdkDir)\</SalamanderSdkDir>
    <SalamanderSharedDir>$(SalamanderSdkDir)plugins\shared\</SalamanderSharedDir>
    <SharepointOutDir>$(SharepointRootDir)build\$(Configuration)_$(Platform)\</SharepointOutDir>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateManifest>false</GenerateManifest>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>
  <Target Name="SharepointCheckSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SalamanderSharedDir)spl_base.h')"
           Text="Open Salamander SDK not found in '$(SalamanderSdkDir)'. Pass /p:SalamanderSdkDir=&lt;path to samandarin\src&gt;." />
  </Target>
</Project>
