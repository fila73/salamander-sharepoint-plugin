IDD_CFGPAGEACCOUNTS DIALOGEX 66, 53, 250, 186
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Accounts"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Microsoft Accounts",IDC_STATIC_1,4,4,242,76
    LTEXT           "Active Account:",IDC_STATIC_2,12,18,55,8
    COMBOBOX        IDC_CFG_ACCOUNTS_COMBO,70,16,166,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Add Account...",IDC_CFG_ACCOUNT_ADD_BTN,12,34,68,14
    PUSHBUTTON      "&Set Active",IDC_CFG_ACCOUNT_SWITCH_BTN,84,34,68,14
    PUSHBUTTON      "&Remove",IDC_CFG_ACCOUNT_REMOVE_BTN,156,34,68,14
    LTEXT           "Manage connected Microsoft 365 accounts. Each has its own isolated cache.",IDC_STATIC_7,12,54,224,18

    GROUPBOX        "Azure AD / Entra ID App Registration",IDC_STATIC_3,4,84,242,98
    LTEXT           "Application (Client) &ID:",IDC_STATIC_4,12,96,120,8
    EDITTEXT        IDC_CFG_CLIENTID,12,107,224,14,ES_AUTOHSCROLL
    LTEXT           "Directory (&Tenant) ID (default: common):",IDC_STATIC_5,12,124,160,8
    EDITTEXT        IDC_CFG_TENANTID,12,135,156,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Save Keys",IDC_CFG_ACCOUNT_SAVE_BTN,174,135,62,14
    LTEXT           "Note: To use custom keys, register an app in Microsoft Entra Admin Center.",IDC_STATIC_6,12,154,224,20
END

IDD_CFGPAGEDISPLAY DIALOGEX 66, 53, 250, 186
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Display && Files"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "File Names && Downloads",IDC_STATIC_1,4,4,242,100
    CONTROL         "&Sanitize incompatible Windows characters on download (\\ / : * ? "" < > |)",IDC_CFG_SANITIZE_INVALID_CHARS,"Button",BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP,12,18,224,18
    LTEXT           "Replacement character:",IDC_STATIC_2,26,42,85,8
    EDITTEXT        IDC_CFG_SANITIZE_CHAR,115,40,16,12,ES_AUTOHSCROLL
    LTEXT           "Replaces characters not permitted by Windows when downloading files or folders to local drives.",IDC_STATIC_3,12,60,224,36
END

IDD_CFGPAGECACHE DIALOGEX 66, 53, 250, 186
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Cache && Sync"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Metadata Cache & Sync",IDC_STATIC_1,4,4,242,126
    CONTROL         "&Enable persistent metadata cache on disk",IDC_CFG_CACHE_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,18,220,10
    LTEXT           "Changes check frequency (TTL):",IDC_STATIC_2,12,32,220,8
    COMBOBOX        IDC_CFG_CACHE_INTERVAL_COMBO,12,42,224,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Ctrl+R: Do not force reload if current folder is unchanged",IDC_CFG_SMART_CTRL_R,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,58,224,10
    CONTROL         "Enable detailed &debug logging to file",IDC_CFG_DEBUG_LOGGING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,72,224,10
    LTEXT           "Cache status: Ready (Isolated per account)",IDC_CFG_CACHE_STATUS,12,88,220,8
    PUSHBUTTON      "&Clear Cache for Active Account",IDC_CFG_CACHE_CLEAR_BTN,12,104,150,14

    GROUPBOX        "Information",IDC_STATIC_3,4,134,242,48
    LTEXT           "The smart cache speeds up folder browsing.\nChanges on SharePoint/OneDrive are detected using the Graph Delta API without unnecessary full folder re-downloads.",IDC_STATIC_4,12,144,224,34
END

IDD_TRANSFER_PROGRESS DIALOGEX 0, 0, 260, 138
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SharePoint Transfer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Transferring:",IDC_TRANSFER_ACTION_LABEL,15,10,230,8
    LTEXT           "",IDC_TRANSFER_FILENAME,15,22,230,8,SS_PATHELLIPSIS
    CONTROL         "",IDC_TRANSFER_PROGRESSBAR,"msctls_progress32",WS_BORDER,15,34,230,12
    LTEXT           "",IDC_TRANSFER_BYTES,15,48,140,8
    RTEXT           "",IDC_TRANSFER_SPEED,160,48,85,8

    LTEXT           "Total progress:",IDC_TRANSFER_TOTAL_LABEL,15,64,230,8
    CONTROL         "",IDC_TRANSFER_TOTAL_PROGRESSBAR,"msctls_progress32",WS_BORDER,15,76,230,12
    LTEXT           "",IDC_TRANSFER_TOTAL_BYTES,15,90,140,8
    RTEXT           "",IDC_TRANSFER_TOTAL_FILES,160,90,85,8

    PUSHBUTTON      "Cancel",IDCANCEL,100,114,60,14
END

IDD_FIND DIALOGEX 0, 0, 360, 250
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Find Files on SharePoint / OneDrive"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Named:",IDC_STATIC_1,10,12,30,8
    COMBOBOX        IDC_FIND_NAMED,45,10,210,100,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Look in:",IDC_STATIC_2,10,28,30,8
    COMBOBOX        IDC_FIND_LOOKIN,45,26,210,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "&Find Now",IDC_FIND_BTN_FINDNOW,265,10,85,14
    PUSHBUTTON      "&Stop",IDC_FIND_BTN_STOP,265,26,85,14

    CONTROL         "",IDC_FIND_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,10,50,340,150

    PUSHBUTTON      "&Focus in Panel",IDC_FIND_BTN_FOCUS,10,206,75,14
    PUSHBUTTON      "&View (F3)",IDC_FIND_BTN_VIEW,90,206,65,14
    PUSHBUTTON      "Open &Web",IDC_FIND_BTN_OPENWEB,160,206,65,14
    PUSHBUTTON      "&Copy Link",IDC_FIND_BTN_COPYLINK,230,206,65,14
    PUSHBUTTON      "Close",IDCANCEL,300,206,50,14

    LTEXT           "Ready",IDC_FIND_STATUS,10,230,340,10
END

